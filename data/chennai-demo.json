  "meta": {
    "name": "BackBy Chennai demo dataset",
    "version": 1,
    "disclaimer": "DEMO DATA. Fares, durations and service windows are approximations for building and testing BackBy. Verify against CMRL, Southern Railway and MTC before real-world use. Always label this as 'demo dataset' in the UI.",
    "timeUnit": "Minutes since midnight (0-1440). The engine converts to epoch minutes using the outing date.",
    "moneyUnit": "Integer paise (100 paise = 1 rupee). Never use floats for money."
  },

  "modeDefaults": {
    "walk":     { "serviceWindow": { "first": 0,   "last": 1440 }, "headwayMin": 0,  "waitAllowanceMin": 0,  "delayAllowanceMin": 0 },
