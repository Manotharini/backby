  "edgeNotes": "All edges are bidirectional. The RoutingProvider must expand each edge into both directions. If an edge has no serviceWindow, use modeDefaults[mode].serviceWindow. Departure times for scheduled modes are first + k * headwayMin, not later than serviceWindow.last. Autos and walking are on-demand (add waitAllowanceMin for autos).",

  "testScenarios": [
    {
      "id": "S1_happy_path",
      "request": "I'm at my Guindy hostel and want to go to Marina Beach at 4 PM for about 2 hours. Budget 600 rupees, keep 200 as emergency reserve, hostel curfew is 9:30 PM. I prefer metro and bus, no autos unless needed.",
      "expected": "At least one valid plan (metro to Central then bus to Marina, and back). Curfew slack is thin but positive after delay allowances. Auto plans rejected or ranked lower due to the preference."
    },
    {
      "id": "S2_unknown_fare",
      "request": "From Guindy hostel to Marina Beach via Express Avenue, bus only, budget 500, reserve 150, curfew 10 PM, leaving 5 PM, stay 90 minutes.",
      "expected": "The only bus route from Express Avenue to Marina has an unknown fare. Plan is rejected unless the user allows fare uncertainty. If allowed, it is flagged and uses unknownFareFallbackPaise.bus."
    },
    {
      "id": "S3_no_safe_plan",
      "request": "Leaving my Guindy hostel at 8:30 PM for Phoenix Marketcity, stay 1 hour, budget 400, reserve 150, curfew 11 PM.",
      "expected": "No plan satisfies all constraints (last Guindy-Velachery bus 9:45 PM, curfew buffer needs return by 10:30 PM). UI must show the failing constraint and a least-bad option labelled NOT SAFE."
    },
    {
      "id": "S4_budget_impossible",
      "request": "Going from Guindy hostel to Marina Beach with 150 rupees, and 100 must stay as reserve. Curfew 10 PM, leaving 4 PM.",
      "expected": "Spendable is 50 rupees, but the cheapest worst-case round trip is more. No valid plan. Show which constraint failed and how much more budget is needed."
    },
    {
      "id": "S5_night_surcharge",
      "request": "Hostel Guindy to T Nagar at 9:30 PM by auto, stay 90 minutes, budget 800, reserve 200, curfew 12:30 AM.",
      "expected": "The return auto leg departs after 11 PM, so the 1.5x night surcharge must be applied to both fare min and max before budget and reserve checks."
    },
    {
      "id": "S6_disruption_replan",
      "steps": "Take the S1 plan. Simulate: the return metro leg Central to Guindy is cancelled.",
      "expected": "Re-plan from Chennai Central using remaining budget and time. Fallback options: Central to Egmore then suburban to Guindy, or Velachery route (if the time window still allows). If none valid, show NOT SAFE with reasons."
    }
  ]
